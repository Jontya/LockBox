{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for LockBox",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-create-dir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-app-write-recursive",
    "fs:allow-app-read-recursive",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
